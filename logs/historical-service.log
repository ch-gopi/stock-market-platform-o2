2026-01-07T21:46:59.279+05:30 DEBUG 29848 --- [historical-service] [http-nio-0.0.0.0-8094-exec-6] [695e86fb8deb436f29aa75744c9fb4db-29aa75744c9fb4db] org.hibernate.SQL                        : 
    SELECT
        DISTINCT 
            ON (day)     symbol,
            day * 1000 AS day_ts,
            open,
            high,
            low,
            close,
            volume 
    FROM
        (     SELECT
            symbol,
            (timestamp / 1000 / 86400) * 86400 AS day,
            FIRST_VALUE(open) OVER w AS open,
            MAX(high)         OVER w AS high,
            MIN(low)          OVER w AS low,
            LAST_VALUE(close) OVER w AS close,
            SUM(volume)       OVER w AS volume     
        FROM
            candles     
        WHERE
            symbol = ?       
            AND timestamp BETWEEN ? AND ?     WINDOW w AS (         PARTITION 
        BY
            (timestamp / 1000 / 86400)         
        ORDER BY
            timestamp         ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING     ) ) AS t 
    ORDER BY
        day DESC 
